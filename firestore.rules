    function isValidLastDayDream(data, dreamId) {
      return data.keys().hasAll([
          'id', 'userId', 'title', 'description', 'category', 'status',
          'targetDate', 'steps', 'linkedCalendarEventId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'title', 'description', 'category', 'status',
          'targetDate', 'steps', 'linkedCalendarEventId', 'createdAt', 'updatedAt'
        ])
        && data.id == dreamId
        && isValidId(data.id)
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && isValidString(data.title, 1, 180)
        && isValidString(data.description, 0, 3000)
        && (data.category is string && data.category in ['viajes', 'familia', 'aprendizaje', 'salud', 'creatividad', 'proyecto', 'naturaleza', 'otro'])
        && (data.status is string && data.status in ['pendiente', 'en_marcha', 'cumplido'])
        && isValidString(data.targetDate, 0, 20)
        && isValidStringList(data.steps, 20, 200)
        && isValidString(data.linkedCalendarEventId, 0, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /lastDayDreams/{dreamId} {
      allow get: if isValidId(dreamId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(dreamId)
        && isVerifiedUser()
        && isValidLastDayDream(incoming(), dreamId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(dreamId)
        && isVerifiedUser()
        && isValidLastDayDream(incoming(), dreamId)
        && existing().userId == request.auth.uid
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'description', 'category', 'status',
          'targetDate', 'steps', 'linkedCalendarEventId', 'updatedAt'
        ]);
      allow delete: if isValidId(dreamId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }

    function isValidLastDayWriting(data, writingId) {
      return data.keys().hasAll([
          'id', 'userId', 'writingType', 'title', 'contentHtml',
          'contentText', 'moodTag', 'wordCount', 'dateKey',
          'aiSummary', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'writingType', 'title', 'contentHtml',
          'contentText', 'moodTag', 'wordCount', 'dateKey',
          'aiSummary', 'createdAt', 'updatedAt'
        ])
        && data.id == writingId
        && isValidId(data.id)
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && (data.writingType is string && data.writingType in ['diario', 'carta', 'poema', 'cancion', 'relato', 'autobiografia'])
        && isValidString(data.title, 1, 200)
        && isValidString(data.contentHtml, 0, 300000)
        && isValidString(data.contentText, 0, 300000)
        && isValidString(data.moodTag, 0, 80)
        && (data.wordCount is number && data.wordCount >= 0 && data.wordCount <= 500000)
        && isValidString(data.dateKey, 0, 20)
        && isValidString(data.aiSummary, 0, 20000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /lastDayWritings/{writingId} {
      allow get: if isValidId(writingId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(writingId)
        && isVerifiedUser()
        && isValidLastDayWriting(incoming(), writingId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(writingId)
        && isVerifiedUser()
        && isValidLastDayWriting(incoming(), writingId)
        && existing().userId == request.auth.uid
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'writingType', 'title', 'contentHtml', 'contentText',
          'moodTag', 'wordCount', 'dateKey', 'aiSummary', 'updatedAt'
        ]);
      allow delete: if isValidId(writingId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }

    function isValidLastDayMemory(data, memoryId) {
      return data.keys().hasAll([
          'id', 'userId', 'mediaType', 'prefKind', 'title', 'story',
          'mediaUrl', 'storagePath', 'youtubeVideoId', 'creatorOrArtist',
          'locationOrPeople', 'memoryDate', 'favorite', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'mediaType', 'prefKind', 'title', 'story',
          'mediaUrl', 'storagePath', 'youtubeVideoId', 'creatorOrArtist',
          'locationOrPeople', 'memoryDate', 'favorite', 'createdAt', 'updatedAt'
        ])
        && data.id == memoryId
        && isValidId(data.id)
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && (data.mediaType is string && data.mediaType in ['foto', 'video', 'preferencia'])
        && (data.prefKind is string && data.prefKind in ['recuerdo', 'musica', 'pelicula', 'libro', 'lugar', 'frase', 'otro'])
        && isValidString(data.title, 1, 180)
        && isValidString(data.story, 0, 4000)
        && isValidString(data.mediaUrl, 0, 350000)
        && isValidString(data.storagePath, 0, 500)
        && isValidString(data.youtubeVideoId, 0, 32)
        && isValidString(data.creatorOrArtist, 0, 150)
        && isValidString(data.locationOrPeople, 0, 200)
        && isValidString(data.memoryDate, 0, 20)
        && (data.favorite is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /lastDayMemories/{memoryId} {
      allow get: if isValidId(memoryId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(memoryId)
        && isVerifiedUser()
        && isValidLastDayMemory(incoming(), memoryId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(memoryId)
        && isVerifiedUser()
        && isValidLastDayMemory(incoming(), memoryId)
        && existing().userId == request.auth.uid
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'mediaType', 'prefKind', 'title', 'story', 'mediaUrl',
          'storagePath', 'youtubeVideoId', 'creatorOrArtist',
          'locationOrPeople', 'memoryDate', 'favorite', 'updatedAt'
        ]);
      allow delete: if isValidId(memoryId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }

    function isValidLastDayLegacy(data, legacyId) {
      return data.keys().hasAll([
          'id', 'userId', 'recipientName', 'relationship', 'title', 'message',
          'mediaHint', 'consentConfirmed', 'privateOnly', 'autoSendDisabled',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'recipientName', 'relationship', 'title', 'message',
          'mediaHint', 'consentConfirmed', 'privateOnly', 'autoSendDisabled',
          'createdAt', 'updatedAt'
        ])
        && data.id == legacyId
        && isValidId(data.id)
        && data.userId == request.auth.uid
        && isValidId(data.userId)
        && isValidString(data.recipientName, 1, 120)
        && isValidString(data.relationship, 0, 80)
        && isValidString(data.title, 1, 180)
        && isValidString(data.message, 1, 40000)
        && isValidString(data.mediaHint, 0, 500)
        && data.consentConfirmed == true
        && data.privateOnly == true
        && data.autoSendDisabled == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /lastDayLegacy/{legacyId} {
      allow get: if isValidId(legacyId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(legacyId)
        && isVerifiedUser()
        && isValidLastDayLegacy(incoming(), legacyId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(legacyId)
        && isVerifiedUser()
        && isValidLastDayLegacy(incoming(), legacyId)
        && existing().userId == request.auth.uid
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'recipientName', 'relationship', 'title', 'message',
          'mediaHint', 'consentConfirmed', 'privateOnly', 'autoSendDisabled', 'updatedAt'
        ]);
      allow delete: if isValidId(legacyId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }

    function isValidContactRequest(data, reqId) {
      return data.keys().hasAll([
          'id', 'fromUserId', 'fromName', 'toUserId', 'toName',
          'message', 'hasMinorParticipant', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'fromUserId', 'fromName', 'toUserId', 'toName',
          'message', 'hasMinorParticipant', 'status', 'createdAt', 'updatedAt'
        ])
        && data.id == reqId
        && isValidId(data.id)
        && isValidId(data.fromUserId)
        && isValidString(data.fromName, 1, 120)
        && isValidId(data.toUserId)
        && data.fromUserId != data.toUserId
        && isValidString(data.toName, 1, 120)
        && isValidString(data.message, 0, 500)
        && data.hasMinorParticipant == false
        && (data.status is string && data.status in ['pendiente', 'aceptada', 'rechazada'])
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /contactRequests/{requestId} {
      allow get: if isValidId(requestId) && isVerifiedUser() && (
        existing().fromUserId == request.auth.uid || existing().toUserId == request.auth.uid
      );
      allow list: if isVerifiedUser()
        && resource.data.hasMinorParticipant == false
        && (
          resource.data.fromUserId == request.auth.uid ||
          resource.data.toUserId == request.auth.uid
        );
      allow create: if isValidId(requestId)
        && isVerifiedUser()
        && isValidContactRequest(incoming(), requestId)
        && incoming().fromUserId == request.auth.uid
        && incoming().status == 'pendiente'
        && get(/databases/$(database)/documents/publicProfiles/$(incoming().fromUserId)).data.isMinor == false
        && get(/databases/$(database)/documents/publicProfiles/$(incoming().toUserId)).data.isMinor == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(requestId)
        && isVerifiedUser()
        && isValidContactRequest(incoming(), requestId)
        && existing().toUserId == request.auth.uid
        && existing().status == 'pendiente'
        && incoming().id == existing().id
        && incoming().fromUserId == existing().fromUserId
        && incoming().toUserId == existing().toUserId
        && incoming().hasMinorParticipant == false
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (incoming().status == 'aceptada' || incoming().status == 'rechazada')
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isValidId(requestId) && isVerifiedUser() && (
        existing().fromUserId == request.auth.uid ||
        existing().toUserId == request.auth.uid ||
        isAdmin()
      );
    }

    // ------------------------------------------------------------------
    // FABRO HYBRID OFFLINE-FIRST SYNC, HANDLES, PUBLIC WALL & CLOUD CHAT
    // ------------------------------------------------------------------
    function isValidFabroTastes(tastes) {
      return tastes is map
        && tastes.keys().hasOnly(['music', 'movies', 'books', 'food', 'drinks'])
        && (!('music' in tastes) || isValidString(tastes.music, 0, 150))
        && (!('movies' in tastes) || isValidString(tastes.movies, 0, 150))
        && (!('books' in tastes) || isValidString(tastes.books, 0, 150))
        && (!('food' in tastes) || isValidString(tastes.food, 0, 150))
        && (!('drinks' in tastes) || isValidString(tastes.drinks, 0, 150));
    }

    function isValidFabroCloudProfile(data, userId) {
      return data.keys().hasAll(['id', 'uid', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'uid', 'displayName', 'username', 'fabroId', 'photoURL',
          'birthDate', 'isMinor', 'presenceStatus', 'dailyPhrase', 'icebreaker',
          'privacyMode', 'shareTastesPublicly', 'tastes', 'migratedGuestAt', 'updatedAt'
        ])
        && data.id == 'main'
        && data.uid == userId
        && isValidId(data.uid)
        && (!('displayName' in data) || isValidString(data.displayName, 1, 100))
        && (!('username' in data) || isValidHandle(data.username))
        && (!('fabroId' in data) || isValidString(data.fabroId, 0, 40))
        && (!('photoURL' in data) || isValidString(data.photoURL, 0, 140000))
        && (!('birthDate' in data) || isValidString(data.birthDate, 0, 20))
        && (!('isMinor' in data) || data.isMinor is bool)
        && (!('presenceStatus' in data) || (data.presenceStatus is string && data.presenceStatus in ['online', 'focus', 'invisible']))
        && (!('dailyPhrase' in data) || isValidString(data.dailyPhrase, 0, 400))
        && (!('icebreaker' in data) || isValidString(data.icebreaker, 0, 300))
        && (!('privacyMode' in data) || (data.privacyMode is string && data.privacyMode in ['todos', 'grupo', 'invisible']))
        && (!('shareTastesPublicly' in data) || data.shareTastesPublicly is bool)
        && (!('tastes' in data) || isValidFabroTastes(data.tastes))
        && (!('migratedGuestAt' in data) || isValidString(data.migratedGuestAt, 0, 64))
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/profile/{docId} {
      allow get: if docId == 'main' && isSignedInOwner(userId);
      allow list: if isSignedInOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if docId == 'main'
        && isSignedInOwner(userId)
        && isValidFabroCloudProfile(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if docId == 'main'
        && isSignedInOwner(userId)
        && isValidFabroCloudProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'username', 'fabroId', 'photoURL',
          'birthDate', 'isMinor', 'presenceStatus', 'dailyPhrase', 'icebreaker',
          'privacyMode', 'shareTastesPublicly', 'tastes', 'migratedGuestAt', 'updatedAt'
        ]);
      allow delete: if docId == 'main' && isSignedInOwner(userId);
    }

    function isValidFabroCloudNote(data, noteId, userId) {
      return data.keys().hasAll([
          'id', 'uid', 'title', 'subject', 'folder', 'tags', 'favorite', 'syncedAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'title', 'subject', 'folder', 'tags', 'favorite',
          'mainIdea', 'summaryText', 'contentHtml', 'contentText',
          'createdAt', 'updatedAt', 'syncedAt'
        ])
        && data.id == noteId
        && isValidId(data.id)
        && data.uid == userId
        && isValidId(data.uid)
        && isValidString(data.title, 1, 200)
        && isValidString(data.subject, 0, 100)
        && isValidString(data.folder, 0, 100)
        && isValidStringList(data.tags, 15, 60)
        && (data.favorite is bool)
        && (!('mainIdea' in data) || isValidString(data.mainIdea, 0, 2000))
        && (!('summaryText' in data) || isValidString(data.summaryText, 0, 4000))
        && (!('contentHtml' in data) || isValidString(data.contentHtml, 0, 200000))
        && (!('contentText' in data) || isValidString(data.contentText, 0, 200000))
        && (!('createdAt' in data) || isValidString(data.createdAt, 0, 64))
        && (!('updatedAt' in data) || isValidString(data.updatedAt, 0, 64))
        && data.syncedAt is timestamp;
    }

    match /users/{userId}/notes/{noteId} {
      allow get: if isValidId(noteId) && isSignedInOwner(userId);
      allow list: if isSignedInOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if isValidId(noteId)
        && isSignedInOwner(userId)
        && isValidFabroCloudNote(incoming(), noteId, userId)
        && incoming().syncedAt == request.time;
      allow update: if isValidId(noteId)
        && isSignedInOwner(userId)
        && isValidFabroCloudNote(incoming(), noteId, userId)
        && incoming().id == existing().id
        && incoming().uid == existing().uid
        && incoming().syncedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subject', 'folder', 'tags', 'favorite',
          'mainIdea', 'summaryText', 'contentHtml', 'contentText',
          'updatedAt', 'syncedAt'
        ]);
      allow delete: if isValidId(noteId) && isSignedInOwner(userId);
    }

    function isValidFabroOrganizerState(data, userId) {
      return data.keys().hasAll([
          'id', 'uid', 'inboxItems', 'organizerTasks', 'timeBlocks', 'dailyReview', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'inboxItems', 'organizerTasks', 'timeBlocks', 'dailyReview', 'updatedAt'
        ])
        && data.id == 'state'
        && data.uid == userId
        && isValidId(data.uid)
        && (data.inboxItems is list && data.inboxItems.size() <= 100)
        && (data.organizerTasks is list && data.organizerTasks.size() <= 200)
        && (data.timeBlocks is list && data.timeBlocks.size() <= 150)
        && (data.dailyReview is map)
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/organizer/{itemId} {
      allow get: if itemId == 'state' && isSignedInOwner(userId);
      allow list: if isSignedInOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if itemId == 'state'
        && isSignedInOwner(userId)
        && isValidFabroOrganizerState(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if itemId == 'state'
        && isSignedInOwner(userId)
        && isValidFabroOrganizerState(incoming(), userId)
        && incoming().id == existing().id
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'inboxItems', 'organizerTasks', 'timeBlocks', 'dailyReview', 'updatedAt'
        ]);
      allow delete: if itemId == 'state' && isSignedInOwner(userId);
    }

    function isValidFabroWellnessState(data, userId) {
      return data.keys().hasAll([
          'id', 'uid', 'moodLogs', 'guidedReflections', 'balancedPlanner', 'glossaryTerms', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'uid', 'moodLogs', 'guidedReflections', 'balancedPlanner', 'glossaryTerms', 'updatedAt'
        ])
        && data.id == 'state'
        && data.uid == userId
        && isValidId(data.uid)
        && (data.moodLogs is list && data.moodLogs.size() <= 60)
        && (data.guidedReflections is list && data.guidedReflections.size() <= 20)
        && (data.balancedPlanner is list && data.balancedPlanner.size() <= 30)
        && (data.glossaryTerms is list && data.glossaryTerms.size() <= 120)
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/wellness/{itemId} {
      allow get: if itemId == 'state' && isSignedInOwner(userId);
      allow list: if isSignedInOwner(userId) && resource.data.uid == request.auth.uid;
      allow create: if itemId == 'state'
        && isSignedInOwner(userId)
        && isValidFabroWellnessState(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if itemId == 'state'
        && isSignedInOwner(userId)
        && isValidFabroWellnessState(incoming(), userId)
        && incoming().id == existing().id
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'moodLogs', 'guidedReflections', 'balancedPlanner', 'glossaryTerms', 'updatedAt'
        ]);
      allow delete: if itemId == 'state' && isSignedInOwner(userId);
    }

    function isValidPublicHandleDoc(data, handle) {
      return data.keys().hasAll(['handle', 'uid', 'updatedAt'])
        && data.keys().hasOnly(['handle', 'uid', 'updatedAt'])
        && data.handle == handle
        && isValidHandle(data.handle)
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.updatedAt is timestamp;
    }

    match /publicHandles/{handle} {
      allow get: if isValidHandle(handle);
      allow list: if false;
      allow create: if isValidHandle(handle)
        && isSignedIn()
        && isValidPublicHandleDoc(incoming(), handle)
        && incoming().updatedAt == request.time;
      allow update: if isValidHandle(handle)
        && isSignedIn()
        && existing().uid == request.auth.uid
        && isValidPublicHandleDoc(incoming(), handle)
        && incoming().uid == existing().uid
        && incoming().handle == existing().handle
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']);
      allow delete: if isValidHandle(handle) && isSignedIn() && existing().uid == request.auth.uid;
    }

    function isValidPublicWallPost(data, postId) {
      return data.keys().hasAll([
          'id', 'authorUid', 'author', 'fabroId', 'text', 'likes',
          'createdAtLabel', 'createdAtMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'authorUid', 'author', 'fabroId', 'text', 'likes',
          'createdAtLabel', 'createdAtMs', 'poll', 'createdAt', 'updatedAt'
        ])
        && data.id == postId
        && isValidId(data.id)
        && isValidId(data.authorUid)
        && isValidString(data.author, 1, 100)
        && isValidString(data.fabroId, 0, 50)
        && isValidString(data.text, 1, 2000)
        && (data.likes is number && data.likes >= 0 && data.likes <= 1000000)
        && isValidString(data.createdAtLabel, 1, 40)
        && (data.createdAtMs is number && data.createdAtMs > 0)
        && (!('poll' in data) || (
          data.poll is map &&
          data.poll.keys().hasAll(['question', 'options']) &&
          data.poll.options is list &&
          data.poll.options.size() >= 2 &&
          data.poll.options.size() <= 4
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /public_posts/{postId} {
      allow get: if isValidId(postId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.likes >= 0;
      allow create: if isValidId(postId)
        && isSignedIn()
        && isValidPublicWallPost(incoming(), postId)
        && incoming().authorUid == request.auth.uid
        && incoming().likes == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(postId)
        && isSignedIn()
        && isValidPublicWallPost(incoming(), postId)
        && incoming().id == existing().id
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().createdAtMs == existing().createdAtMs
        && incoming().updatedAt == request.time
        && (
          (
            existing().authorUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['text', 'poll', 'updatedAt'])
          ) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['poll', 'updatedAt'])
        );
      allow delete: if isValidId(postId) && isSignedIn() && (existing().authorUid == request.auth.uid || isAdmin());
    }

    function isValidCloudChatRoom(data, chatId) {
      return data.keys().hasAll(['id', 'updatedAt'])
        && data.keys().hasOnly(['id', 'updatedAt'])
        && data.id == chatId
        && isValidId(data.id)
        && data.updatedAt is timestamp;
    }

    function isValidCloudChatMessage(data, chatId, msgId) {
      return data.keys().hasAll([
          'id', 'chatId', 'senderUid', 'sender', 'text', 'time', 'createdAtMs', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'chatId', 'senderUid', 'sender', 'text', 'time', 'sticker', 'createdAtMs', 'createdAt'
        ])
        && data.id == msgId
        && isValidId(data.id)
        && data.chatId == chatId
        && isValidId(data.chatId)
        && data.senderUid == request.auth.uid
        && isValidId(data.senderUid)
        && isValidString(data.sender, 1, 100)
        && isValidString(data.text, 1, 4000)
        && isValidString(data.time, 0, 20)
        && (!('sticker' in data) || isValidString(data.sticker, 1, 16))
        && (data.createdAtMs is number && data.createdAtMs > 0)
        && data.createdAt is timestamp;
    }

    match /chats/{chatId} {
      allow get: if isValidId(chatId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.id is string;
      allow create: if isValidId(chatId)
        && isSignedIn()
        && isValidCloudChatRoom(incoming(), chatId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(chatId)
        && isSignedIn()
        && isValidCloudChatRoom(incoming(), chatId)
        && incoming().id == existing().id
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']);
      allow delete: if isValidId(chatId) && isAdmin();

      match /messages/{msgId} {
        allow get: if isValidId(chatId) && isValidId(msgId) && isSignedIn();
        allow list: if isSignedIn() && resource.data.chatId is string;
        allow create: if isValidId(chatId)
          && isValidId(msgId)
          && isSignedIn()
          && exists(/databases/$(database)/documents/chats/$(chatId))
          && isValidCloudChatMessage(incoming(), chatId, msgId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(chatId)
          && isValidId(msgId)
          && isSignedIn()
          && (existing().senderUid == request.auth.uid || isAdmin());
      }
    }
  }
}

