        && existing().userId == request.auth.uid
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'dateKey', 'title', 'category', 'scheduledTime', 'durationMinutes',
          'elapsedSeconds', 'status', 'notes', 'rolledOverFromDate',
          'isHabitualTemplate', 'updatedAt'
        ]);
      allow delete: if isValidId(activityId) && isVerifiedUser() && existing().userId == request.auth.uid;
