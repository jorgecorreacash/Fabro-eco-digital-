# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY (Opcional): ChatGPT (OpenAI API comercial).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ANTHROPIC_API_KEY (Opcional): Claude (Anthropic API comercial).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# DEEPSEEK_API_KEY (Opcional): DeepSeek Chat / Reasoner.
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# MISTRAL_API_KEY (Opcional): Mistral Le Chat API.
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# GROQ_API_KEY (Opcional): Groq Cloud (cuota gratuita / ultra rápida para modelos abiertos Llama).
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# OPENROUTER_API_KEY (Opcional): OpenRouter (acceso unificado a modelos gratuitos :free y comerciales).
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"

# OLLAMA_BASE_URL (Opcional): Servidor local o autoalojado Ollama (ej. http://localhost:11434).
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3.2"

# YOUTUBE_API_KEY (Opcional): YouTube Data API v3 para búsquedas directas en Videoteca (si no se configura, usa búsqueda con Gemini Search + oEmbed).
YOUTUBE_API_KEY=""

# FABRO_CONNECT_MASTER_KEY (Opcional): Secreto maestro para cifrado AES-256-GCM en servidor de claves BYOK (si se omite se genera clave persistente en servidor).
FABRO_CONNECT_MASTER_KEY=""

# Sign in with ChatGPT OAuth 2.0 + PKCE (Opcional: requiere Client ID oficial autorizado por OpenAI).
OPENAI_CHATGPT_OAUTH_CLIENT_ID=""
OPENAI_CHATGPT_OAUTH_REDIRECT_URI=""

